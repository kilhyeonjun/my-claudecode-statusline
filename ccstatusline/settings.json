{
  "version": 3,
  "lines": [
    [
      {
        "id": "l1-model",
        "type": "model",
        "color": "cyan"
      },
      {
        "id": "l1-sep1",
        "type": "separator"
      },
      {
        "id": "l1-autopilot",
        "type": "custom-command",
        "commandPath": "bash __CLAUDE_SCRIPTS__/statusline-autopilot.sh",
        "timeout": 1500,
        "color": "brightYellow",
        "preserveColors": false
      },
      {
        "id": "l1-sep2",
        "type": "separator"
      },
      {
        "id": "l1-branch",
        "type": "git-branch",
        "color": "magenta"
      },
      {
        "id": "l1-sep3",
        "type": "separator"
      },
      {
        "id": "l1-changes",
        "type": "git-changes",
        "color": "yellow"
      }
    ],
    [
      {
        "id": "l2-cwd",
        "type": "current-working-dir",
        "color": "blue"
      }
    ],
    [
      {
        "id": "l3-ctxbar",
        "type": "context-bar",
        "color": "green"
      },
      {
        "id": "l3-sep1",
        "type": "separator"
      },
      {
        "id": "l3-clock",
        "type": "session-clock",
        "color": "brightBlack"
      },
      {
        "id": "l3-sep2",
        "type": "separator"
      },
      {
        "id": "l3-ctxburn",
        "type": "custom-command",
        "commandPath": "bash __CLAUDE_SCRIPTS__/statusline-burn.sh",
        "timeout": 2000,
        "color": "brightBlack",
        "preserveColors": false
      }
    ],
    [
      {
        "id": "l4-usage",
        "type": "custom-command",
        "commandPath": "bash __CLAUDE_SCRIPTS__/statusline-usage.sh",
        "timeout": 2500,
        "color": "brightCyan",
        "preserveColors": false
      }
    ],
    [
      {
        "id": "l5-skills",
        "type": "skills",
        "color": "brightMagenta",
        "metadata": {
          "mode": "list",
          "hideWhenEmpty": "true",
          "listLimit": "6"
        }
      }
    ]
  ],
  "flexMode": "full",
  "compactThreshold": 60,
  "colorLevel": 2,
  "defaultPadding": " ",
  "inheritSeparatorColors": true,
  "globalBold": true,
  "powerline": {
    "enabled": false,
    "separators": [""],
    "separatorInvertBackground": [false],
    "startCaps": [],
    "endCaps": [],
    "theme": "nord-aurora"
  }
}
